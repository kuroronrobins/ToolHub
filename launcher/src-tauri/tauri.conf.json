{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolHub",
  "version": "0.1.3",
  "identifier": "com.toolhub.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolHub",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../runner": "runner",
      "../../apps": "apps",
      "../../runtime": "runtime",
      "../../config.default": "config.default",
      "../../release/manifest.json": "release/manifest.json",
      "../../release/app_manifest.json": "release/app_manifest.json",
      "../../tools/app_studio/main.py": "tools/app_studio/main.py",
      "../../tools/app_studio/app_studio": "tools/app_studio/app_studio",
      "../../tools/app_studio/assets": "tools/app_studio/assets",
      "../../updater": "updater",
      "../../README.md": "README.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/toolhub_install_dir.nsh"
      }
    }
  }
}
