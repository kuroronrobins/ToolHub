# XC-Gate: チェックシート登録 自動アップロードフロー(XCgate)

vars:
  # 開始URL(manual-kickoff なら不要)
  # 生産工程
  site: "http://10.9.220.35/xcent/app/C1000/login/?companyCd=C1000"
  # site: "http://192.168.1.35/xcent/app/C1000/login/?companyCd=C1000"
  # 実行時 --pick-files / --files で供給
  files: ${files}
  # リトライと間隔(短縮版)
  max_retries: 2
  retry_interval_ms: 1000
  complete_timeout_ms: 60000
  form_timeout_ms: 30000

selectors:
  # 登録フォームの判定（URL遷移直後に安定している要素）
  form_marker:        text:"XLSXファイル" | text:"ファイルの選択" | css:"input[name='uploadFile']"

  # フォルダ一覧にある「新しいチェックシート」ボタン
  btn_new_checksheet: text:"新しいチェックシート" | text:"新規チェックシート" | css:"input[type='button'][value='新しいチェックシート']" | css:"input[type='button'][value='新規チェックシート']"

  # ファイル選択のトリガ（text と input の両方を用意）
  btn_choose_file:    text:"ファイルの選択" | css:"input[type='button'][value='ファイルの選択']"

  # <input type=file> フォールバック
  input_file:         { by: "css",  value: "input[type='file'], input[name='uploadFile']" }

  # 登録ボタン（複数候補をCSSで用意）
  btn_register:       css:"button:has-text('登録'), input[type='button'][value='登録'], input[type='submit'][value='登録']"

  # 完了/エラーの判定メッセージ
  done_marker:        text:"登録が完了しました" | text:"チェックシートの登録完了"
  error_marker:       text:"登録中にエラーが発生しました。" | text:"ERROR"

  # 戻る/続けて新規登録 ボタン
  btn_back:           css:"#back_btn input[type='button'], input[type='button'][onclick^='back_onClick']" | text:"戻る"
  btn_continue_new:   css:"input[type='button'][onclick^='reportadd_onClick']" | text:"続けて新規登録"

start:
  # manual-kickoff のとき、最初の goto はスキップされます
  goto ${site}

whens:
  # 1) フォルダ一覧 → 登録フォームへ
  - condition: btn_new_checksheet:
    steps:
      click btn_new_checksheet
      wait form_marker timeout:${form_timeout_ms}

  # 2) 登録フォームでアップロードを実施
  - condition: form_marker:
    steps:
      foreach f in ${files}:
        log "UPLOAD START: ${f}"

        # a) <input type=file> へ直接セット（失敗時は FileChooser フォールバック）
        retry ${max_retries} every ${retry_interval_ms}:
          try:
            set_input_files input_file, files:[${f}]
          catch:
            choose_file open_by:(btn_choose_file), set:${f}

        # b) 登録 → 成功/失敗を OR 待機でレース
        click btn_register
        wait_any [done_marker, btn_continue_new, error_marker] timeout:${complete_timeout_ms}

        # 成功パス（完了メッセージ or 先にボタン表示のどちらでも成功扱い）
        try:
          try:
            wait done_marker timeout:1500
          catch:
            wait btn_continue_new timeout:1500
          log_csv { timestamp: now(), file: "${basename(f)}", destination: "XCgate", result:"OK", error_summary:"", screenshot:"", html:"" }
          log "UPLOAD DONE : ${f}"
          # 成功時は「戻る」でフォルダ一覧へ戻し、改めて新規登録に入る
          retry 20 every 300:
            try:
              click btn_back
            catch:
              click css:"#back_btn input[type='button']"
          wait btn_new_checksheet timeout:${form_timeout_ms}
          click btn_new_checksheet
          wait form_marker timeout:${form_timeout_ms}
        catch:
          # エラーパス（確実に2回「戻る」で初期画面まで戻る）
          wait error_marker timeout:1000
          screenshot path:"logs/${basename(f)}.png", full:false
          log_csv { timestamp: now(), file: "${basename(f)}", destination: "XCgate", result:"NG", error_summary:"FAILED", screenshot:"logs/${basename(f)}.png", html:"" }
          # 1) 登録状況 → 登録フォーム
          retry 20 every 300:
            try:
              click btn_back
            catch:
              click css:"#back_btn input[type='button']"
          wait form_marker timeout:${form_timeout_ms}
          # 2) 登録フォーム → フォルダ一覧
          retry 20 every 300:
            try:
              click btn_back
            catch:
              click css:"#back_btn input[type='button']"
          # 3) フォルダ一覧 → 新しいチェックシート → 登録フォーム
          wait btn_new_checksheet timeout:${form_timeout_ms}
          click btn_new_checksheet
          wait form_marker timeout:${form_timeout_ms}

      log "ALL FILES COMPLETED"

